    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
