{
  "name": "vibecomix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VIBECOMIX — векторный редактор макетов комиксов: фреймы, перегородки, слои с параллаксом, экспорт HTML",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --outDir dist",
